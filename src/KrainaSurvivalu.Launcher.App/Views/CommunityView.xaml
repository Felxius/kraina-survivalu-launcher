<UserControl x:Class="KrainaSurvivalu.Launcher.App.Views.CommunityView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Border Style="{StaticResource Panel}" Padding="22,19" Margin="0,0,0,22" BorderBrush="#455438">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,20,0">
     <TextBlock Text="KRAINA SURVIVALU / DISCORD" Style="{StaticResource Eyebrow}"/>
     <TextBlock Text="Przetrwaj z nami." FontSize="25" FontWeight="SemiBold" Margin="0,6,0,6"/>
     <TextBlock Text="Kontakt z administracją, rozmowy i życie naszej społeczności." Style="{StaticResource Muted}"/>
     <TextBlock Text="{Binding DiscordAddress}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,8,0,0"/>
    </StackPanel>
    <Button x:Name="DiscordButton" Grid.Column="1" Content="DOŁĄCZ DO DISCORDA  ↗" Command="{Binding OpenDiscordCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" AutomationProperties.Name="Otwórz oficjalny Discord w przeglądarce"/>
   </Grid>
  </Border>
  <Button Content="ODŚWIEŻ REGULAMIN" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,0,0,22"/>
  <Border Visibility="{Binding HasLoadError, Converter={StaticResource BoolVisibility}}" Background="#33271B" BorderBrush="#91754A" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,18">
   <TextBlock Text="{Binding LoadMessage}" Foreground="#F0D2A3"/>
  </Border>
  <StackPanel>
   <TextBlock Text="{Binding RulesTitle}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="Dołączając do serwera, akceptujesz obowiązujące zasady." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
   <Border Visibility="{Binding IsRulesMissing, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Panel}" Padding="25"><TextBlock Text="Regulamin niedostępny — nie dodano jeszcze jego treści." Style="{StaticResource Muted}"/></Border>
   <Grid Visibility="{Binding HasRules, Converter={StaticResource BoolVisibility}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,20,0">
     <TextBlock Text="SZUKAJ W REGULAMINIE" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/>
     <TextBox x:Name="RulesSearchBox" Text="{Binding RulesSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Szukaj w treści regulaminu"/>
     <Button Content="WYCZYŚĆ WYSZUKIWANIE" Command="{Binding ClearSearchCommand}" Style="{StaticResource SmallButton}" Margin="0,8,0,22"/>
     <TextBlock Text="SPIS TREŚCI" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
     <TextBlock Text="{Binding RulesCountLabel}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,0,0,10"/>
     <ListBox x:Name="RulesList" ItemsSource="{Binding VisibleRules}" SelectedItem="{Binding SelectedRule}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" AutomationProperties.Name="Rozdziały regulaminu">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ChapterBorder" Background="#1A201B" BorderBrush="#303A2F" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ChapterBorder" Property="Background" Value="#303E28"/><Setter TargetName="ChapterBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChapterBorder" Property="BorderBrush" Value="#ABBE7F"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChapterBorder" Property="BorderBrush" Value="#DAE9BD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontSize="12" LineHeight="18"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
    <StackPanel Grid.Column="1">
     <Border Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Panel}" Padding="25"><TextBlock Text="Nie znaleziono pasujących rozdziałów. Zmień wyszukiwane słowo lub wyczyść pole." Style="{StaticResource Muted}"/></Border>
     <Border Style="{StaticResource Panel}" Padding="24">
      <StackPanel><TextBlock Text="{Binding SelectedRule.Title}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock x:Name="RulesBodyText" Text="{Binding SelectedRule.Body}" FontSize="13" LineHeight="23"/></StackPanel>
     </Border>
     <WrapPanel Margin="0,15,0,0"><Button Content="←  POPRZEDNI" Command="{Binding PreviousRuleCommand}" Style="{StaticResource SmallButton}" Margin="0,0,10,8"/><Button Content="NASTĘPNY  →" Command="{Binding NextRuleCommand}" Style="{StaticResource SmallButton}" Margin="0,0,0,8"/></WrapPanel>
    </StackPanel>
   </Grid>
   <Button Content="REGULAMIN W PRZEGLĄDARCE  ↗" Command="{Binding OpenRulesSourceCommand}" Visibility="{Binding HasRulesSource, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
  </StackPanel>
 </StackPanel>
</UserControl>
