<Window x:Class="KrainaSurvivalu.Launcher.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:KrainaSurvivalu.Launcher.App.Views"
 Icon="/Assets/Branding/ks-launcher.ico" Title="Kraina Survivalu — Launcher DayZ" Style="{StaticResource {x:Type Window}}" Width="1380" Height="960" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border x:Name="RootSurface" BorderBrush="#354130" BorderThickness="1" CornerRadius="11" Background="{StaticResource BackgroundBrush}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="20,0,7,0"><TextBlock Text="KRAINA SURVIVALU   /   DAYZ LAUNCHER" FontSize="9" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Width="42" Background="Transparent" BorderThickness="0" Padding="0" Click="Minimize_Click" AutomationProperties.Name="Minimalizuj"/><Button Content="□" Width="42" Background="Transparent" BorderThickness="0" Padding="0" Click="Maximize_Click" AutomationProperties.Name="Maksymalizuj lub przywróć"/><Button Content="✕" Width="42" Background="Transparent" BorderThickness="0" Padding="0" Click="Close_Click" AutomationProperties.Name="Zamknij"/></StackPanel></Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,10">
     <Grid Margin="18,25,18,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="10,0,0,34"><Grid><Border Width="47" Height="47" HorizontalAlignment="Left" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5"><TextBlock Text="KS" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Margin="59,1,0,0"><TextBlock Text="KRAINA" FontSize="17" FontWeight="Bold"/><TextBlock Text="SURVIVALU" FontSize="13" Foreground="{StaticResource AccentBrush}"/></StackPanel></Grid><TextBlock Text="TWOJA STREFA PRZETRWANIA" Foreground="{StaticResource DimBrush}" FontSize="8" Margin="0,14,0,0"/></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock Text="NAWIGACJA" Style="{StaticResource Eyebrow}" Foreground="{StaticResource DimBrush}" Margin="16,0,0,9"/>
       <Button Command="{Binding NavigateCommand}" CommandParameter="Home"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsHomePage}" Value="True"><Setter Property="Background" Value="#2B3725"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="01     Strona główna" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
       <Button Command="{Binding NavigateCommand}" CommandParameter="Mods"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsModsPage}" Value="True"><Setter Property="Background" Value="#2B3725"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="02     Mody serwerów" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
       <Button Command="{Binding NavigateCommand}" CommandParameter="Community"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCommunityPage}" Value="True"><Setter Property="Background" Value="#2B3725"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="03     Społeczność" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
       <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsPage}" Value="True"><Setter Property="Background" Value="#2B3725"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="04     Ustawienia" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
      </StackPanel>
      <StackPanel Grid.Row="3" Margin="10,0"><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,17,0,0"><StackPanel><TextBlock Text="LAUNCHER W BUDOWIE" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock Text="{Binding Version}" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="Windows / .NET 10" Foreground="{StaticResource DimBrush}" FontSize="10" Margin="0,11,0,0"/></StackPanel></Border></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,20,22,15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,10,23"><StackPanel><TextBlock x:Name="PageHeading" Text="{Binding PageTitle}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#202A1D" BorderBrush="#3A4A30" BorderThickness="1" CornerRadius="5" Padding="10,7"><TextBlock Text="ETAP 06" Style="{StaticResource Eyebrow}" FontSize="9"/></Border></Grid>
     <ScrollViewer x:Name="MainPageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <Grid>
       <StackPanel Visibility="{Binding IsHomePage, Converter={StaticResource BoolVisibility}}">
        <Border x:Name="ReadyUpdateBanner" Visibility="{Binding IsLauncherUpdateReady, Converter={StaticResource BoolVisibility}}" Background="#283921" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="17" Margin="0,0,12,18"><StackPanel><TextBlock Text="{Binding LauncherUpdateMessage}" TextWrapping="Wrap"/><Button Content="ZAINSTALUJ I URUCHOM PONOWNIE" Command="{Binding ApplyLauncherUpdateCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
        <Border CornerRadius="10" BorderBrush="#3B4A32" BorderThickness="1" Padding="26,22" Margin="0,0,12,26">
         <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8"><GradientStop Color="#2D3B25" Offset="0"/><GradientStop Color="#1A211A" Offset="0.85"/></LinearGradientBrush></Border.Background>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
 <StackPanel Margin="0,0,20,0"><TextBlock Text="WITAJ W KRAINIE SURVIVALU" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock Text="Dwa światy." FontSize="31" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="Jedna społeczność." FontSize="31" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Przygotuj ekwipunek. Wybierz miejsce, w którym zaczniesz." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
 <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="TWÓJ NICK W GRZE" Style="{StaticResource Eyebrow}" FontSize="9" Margin="0,0,0,8"/><TextBox x:Name="HomePlayerNameBox" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Nick gracza na stronie głównej"/><TextBlock Text="{Binding PlayerNameMessage}" Style="{StaticResource Muted}" FontSize="10" Margin="0,7,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="ZAPISZ NICK" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Padding="12,8"/><Button Grid.Column="1" Content="USTAWIENIA" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource SmallButton}" Margin="8,0,0,0"/></Grid></StackPanel>
</Grid>
        </Border>
        <Grid Margin="0,0,12,14"><TextBlock Text="WYBIERZ SERWER" Style="{StaticResource Eyebrow}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button x:Name="RefreshServersButton" Content="ODŚWIEŻ STATUS" Command="{Binding RefreshServerStatusCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" AutomationProperties.Name="Odśwież status obu serwerów"/></Grid>
        <ItemsControl x:Name="ServerCards" ItemsSource="{Binding Servers}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><views:ServerCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Border Background="#181F17" BorderBrush="#34412D" BorderThickness="1" CornerRadius="7" Padding="15,12" Margin="0,18,12,8"><TextBlock Text="Status odświeża się co minutę. Brak odpowiedzi oznacza, że nie udało się potwierdzić dostępności serwera. Mody sprawdzisz i pobierzesz w ich profilu. Uruchamianie gry jest jeszcze niedostępne." Style="{StaticResource Muted}" FontSize="11"/></Border>
       </StackPanel>
       <StackPanel Visibility="{Binding IsModsPage, Converter={StaticResource BoolVisibility}}" Margin="0,0,12,0">
        <Border Style="{StaticResource Panel}" Padding="25"><StackPanel>
         <TextBlock Text="PROFIL MODÓW" Style="{StaticResource Eyebrow}"/>
         <ComboBox x:Name="ServerSelector" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedModsServer}" DisplayMemberPath="Name" Margin="0,15,0,14" MaxWidth="400" HorizontalAlignment="Left" MinWidth="300"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding SelectedModsServer.Endpoint}" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          <Button x:Name="RefreshModsButton" Grid.Column="1" Content="ODŚWIEŻ LISTĘ MODÓW" Command="{Binding RefreshServerModsCommand}" Style="{StaticResource SmallButton}" AutomationProperties.Name="Odśwież listę modów wybranego serwera"/>
         </Grid>
         <TextBlock x:Name="ModsStatusText" Text="{Binding SelectedModsServer.ModsStatusText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,22,0,10" ToolTip="{Binding SelectedModsServer.ModsDetails}"/>
         <TextBlock x:Name="ModsExplanationText" Text="{Binding SelectedModsServer.ModsExplanation}" Style="{StaticResource Muted}"/>
         <TextBlock x:Name="ModsLastCheckedText" Text="{Binding SelectedModsServer.ModsLastCheckedMessage}" Foreground="{StaticResource DimBrush}" FontSize="10" Margin="0,10,0,0"/>
         <TextBlock x:Name="ModsCountText" Text="{Binding SelectedModsCount}" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,10"/>
         <ItemsControl x:Name="WorkshopModsList" ItemsSource="{Binding SelectedModsServer.WorkshopMods}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border Background="#121810" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="13,11" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
           <TextBlock x:Name="WorkshopModNameText" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,15,0" VerticalAlignment="Center"/>
           <TextBlock x:Name="WorkshopModIdText" Grid.Column="1" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="{Binding WorkshopId, StringFormat=Workshop ID: {0}}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasWorkshopId}" Value="False"><Setter Property="Text" Value="Brak ID Workshop"/><Setter Property="Foreground" Value="#D1AF6D"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid></Border>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock x:Name="ModsEmptyText" Text="{Binding SelectedModsServer.ModsEmptyMessage}" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding SelectedModsServer.HasModsEntries}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         <Border Background="#111810" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="17" Margin="0,22,0,0"><StackPanel>
          <TextBlock Text="MODY NA TYM KOMPUTERZE" Style="{StaticResource Eyebrow}"/>
          <WrapPanel Margin="0,12,0,0"><Button x:Name="InspectModsButton" Content="SPRAWDŹ MODY NA KOMPUTERZE" Command="{Binding InspectWorkshopCommand}" Margin="0,0,8,8" Style="{StaticResource SmallButton}"/><Button x:Name="SynchronizeModsButton" Content="SYNCHRONIZUJ MODY" Command="{Binding SynchronizeWorkshopCommand}" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}"/><Button x:Name="CancelModsButton" Content="ANULUJ ZADANIE" Command="{Binding CancelWorkshopCommand}" Style="{StaticResource SmallButton}" Margin="0,0,0,8"/></WrapPanel>
          <TextBlock x:Name="WorkshopMessageText" Text="{Binding SelectedModsServer.WorkshopMessage}" Style="{StaticResource Muted}" Margin="0,7,0,8"/>
          <ProgressBar x:Name="WorkshopProgressBar" Height="6" Minimum="0" Maximum="100" Value="{Binding SelectedModsServer.WorkshopProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding SelectedModsServer.WorkshopProgressIndeterminate, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#293126" BorderThickness="0"/>
          <TextBlock x:Name="LocalWorkshopSummaryText" Text="{Binding SelectedModsServer.LocalWorkshopSummary}" Style="{StaticResource Muted}" FontSize="10" Margin="0,9,0,8"/>
          <ItemsControl x:Name="LocalModsList" ItemsSource="{Binding SelectedModsServer.LocalWorkshopItems}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10" Margin="0,3"><StackPanel>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock x:Name="LocalModNameText" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,15,0"/><TextBlock x:Name="LocalModStatusText" Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="11" HorizontalAlignment="Right" TextWrapping="Wrap"/></Grid>
           <TextBlock Text="{Binding WorkshopId, StringFormat=Workshop ID: {0}}" FontFamily="Consolas" Foreground="{StaticResource DimBrush}" FontSize="10" Margin="0,4,0,0"/>
           <TextBlock x:Name="LocalModBytesText" Text="{Binding DownloadText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
           <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#293126" BorderThickness="0" Margin="0,5,0,0"/>
           <TextBlock Text="{Binding InstalledPath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding InstalledPath}" Foreground="{StaticResource DimBrush}" FontSize="9" Margin="0,5,0,0"/>
          </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </StackPanel></Border>
        </StackPanel></Border>
        <Border Style="{StaticResource Panel}" Padding="22" Margin="0,17,0,0"><StackPanel><TextBlock Text="Aktualna lista przed i po pobieraniu" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Synchronizacja odczytuje listę ponownie i reaguje na jej zmiany. Pobiera oraz aktualizuje rozpoznane mody przez zalogowany Steam. Modów usuniętych z listy serwera nie kasuje z komputera. Pozycje bez ID i niepotwierdzona kompletność wymagają wyjaśnienia. Uruchamianie gry jest jeszcze niedostępne." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
       </StackPanel>
       <Grid Visibility="{Binding IsCommunityPage, Converter={StaticResource BoolVisibility}}" Margin="0,0,12,0"><views:CommunityView DataContext="{Binding Community}"/></Grid>
       <StackPanel Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolVisibility}}" Margin="0,0,12,0">
        <Border Style="{StaticResource Panel}" Padding="25"><StackPanel><TextBlock Text="INSTALACJA GRY" Style="{StaticResource Eyebrow}"/><TextBlock Text="DayZ i Steam" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Wskaż pliki na tym komputerze. Launcher nie zmienia instalacji gry ani modów." Style="{StaticResource Muted}"/>
         <TextBlock Text="NICK GRACZA" Style="{StaticResource Eyebrow}" Margin="0,24,0,8"/><TextBox x:Name="PlayerNameBox" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Nick gracza w ustawieniach"/><TextBlock Text="{Binding PlayerNameMessage}" Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="Ten nick będzie używany przy uruchamianiu DayZ. Zapisz ustawienia po zmianie." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="Folder DayZ" FontSize="12" Margin="0,24,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DayZPathBox" Text="{Binding DayZDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Folder DayZ"/><Button Grid.Column="1" Content="WYBIERZ FOLDER" Command="{Binding BrowseDayZCommand}" Margin="10,0,0,0" Width="160"/></Grid><TextBlock Text="Folder zawierający DayZ_x64.exe i DayZ_BE.exe" Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
         <TextBlock Text="Plik Steam" FontSize="12" Margin="0,20,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SteamPathBox" Text="{Binding SteamExecutable, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ścieżka do steam.exe"/><Button Grid.Column="1" Content="WYBIERZ PLIK" Command="{Binding BrowseSteamCommand}" Margin="10,0,0,0" Width="160"/></Grid><TextBlock Text="Wskaż steam.exe, nie skrót do aplikacji." Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
         <WrapPanel Margin="0,25,0,0"><Button Content="WYKRYJ AUTOMATYCZNIE" Command="{Binding DetectPathsCommand}" Margin="0,0,9,9"/><Button Content="SPRAWDŹ ŚCIEŻKI" Command="{Binding ValidatePathsCommand}" Margin="0,0,9,9"/><Button Content="ZAPISZ USTAWIENIA" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,9"/></WrapPanel>
         <Border Background="#111810" CornerRadius="5" Padding="13" Margin="0,9,0,0"><TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Muted}"/></Border>
        </StackPanel></Border>
        <Border Style="{StaticResource Panel}" Padding="25" Margin="0,18,0,0"><StackPanel><TextBlock Text="AKTUALIZACJE LAUNCHERA" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Version}" FontSize="21" Margin="0,10,0,9"/><TextBlock x:Name="LauncherUpdateMessageText" Text="{Binding LauncherUpdateMessage}" Style="{StaticResource Muted}"/>
         <ProgressBar x:Name="LauncherUpdateProgressBar" Height="6" Minimum="0" Maximum="100" Value="{Binding LauncherUpdatePercent, Mode=OneWay}" IsIndeterminate="{Binding LauncherUpdateIndeterminate, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#293126" BorderThickness="0" Margin="0,12,0,14"/>
         <WrapPanel><Button x:Name="CheckLauncherUpdatesButton" Content="SPRAWDŹ AKTUALIZACJE" Command="{Binding CheckLauncherUpdatesCommand}" Style="{StaticResource SmallButton}" Margin="0,0,8,8"/><Button x:Name="ApplyLauncherUpdateButton" Content="ZAINSTALUJ I URUCHOM PONOWNIE" Command="{Binding ApplyLauncherUpdateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button x:Name="CancelLauncherUpdateButton" Content="ANULUJ POBIERANIE" Command="{Binding CancelLauncherUpdateCommand}" Style="{StaticResource SmallButton}" Margin="0,0,0,8"/></WrapPanel>
         <TextBlock Text="Po skonfigurowaniu kanału GitHub Releases launcher sam sprawdza i pobiera podpisaną aktualizację przy starcie. Zainstalujesz ją po zakończeniu bieżącego zadania." Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel></Border>
       </StackPanel>
      </Grid>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,10,0" Padding="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="KRAINA SURVIVALU" FontSize="9" Foreground="{StaticResource DimBrush}" Margin="15,0,0,0"/></Grid></Border>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
