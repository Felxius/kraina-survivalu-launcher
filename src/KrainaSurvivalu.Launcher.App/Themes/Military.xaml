<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="BackgroundBrush" Color="#0E110F"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#141814"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#1A201B"/>
  <SolidColorBrush x:Key="LineBrush" Color="#303A2F"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#ABBE7F"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F0F1E9"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A3AD9B"/>
  <SolidColorBrush x:Key="DimBrush" Color="#76826E"/>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
